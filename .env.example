# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.

# ---------------------------------------------------------------------------
# Public — safe to ship to the browser (NEXT_PUBLIC_ prefix required by Next.js)
# ---------------------------------------------------------------------------

# Your Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Cloudflare Turnstile site key (public, safe for the browser). Used to render
# the CAPTCHA widget on the password-reset form. The matching Secret Key is
# entered directly in Supabase's dashboard under Authentication → Attack
# Protection, not here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Supabase anon / publishable key. Safe for the browser: Row Level Security
# policies (see supabase/migrations) are what actually restrict data access,
# not this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The deployed site URL, used for metadata (Open Graph, canonical links) and
# for building email redirect URLs. Use http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only secrets — NEVER prefix with NEXT_PUBLIC_, never import from a
# file that also runs in the browser, never log, never send to the client.
# ---------------------------------------------------------------------------

# Supabase service-role key. Bypasses Row Level Security entirely. Only used
# server-side in lib/supabase/admin.ts, for account deletion. Set this in
# Vercel's encrypted environment variables for production, not in git.
SUPABASE_SERVICE_ROLE_KEY=
